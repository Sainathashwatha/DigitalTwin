# ==========================================
# MQTT Backend & RAG Pipeline Configuration
# ==========================================

# Set to true to use local Ollama model (e.g. llama3.2)
USE_LOCAL_LLM=true

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# MongoDB Persistent Document Store
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=digital_twin_db

# Optional: Cloud LLM API Keys (if USE_LOCAL_LLM=false)
# GEMINI_API_KEY=your_gemini_api_key_here
